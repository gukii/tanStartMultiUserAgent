# PartyKit WebSocket Server Host
# Local development: 127.0.0.1:1999
# Production: your-project.your-username.partykit.dev (without https://)
VITE_PARTYKIT_HOST=127.0.0.1:1999

# AI Agent - Enable field suggestion functionality
# Set to 'true' to enable AI-powered field filling and completion
# Set to 'false' or omit to disable (modular design)
VITE_ENABLE_AI_AGENT=true
